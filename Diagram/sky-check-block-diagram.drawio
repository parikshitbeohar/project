<mxfile host="app.diagrams.net">
  <diagram name="Block Diagram" id="skycheck-block">
    <mxGraphModel dx="900" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sky Check &#8212; System Block Diagram" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="0" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="repo" value="GitHub Repository&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;(source of truth)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ci" value="GitHub Actions&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;CI &#8212; lint, unit/integration tests, Playwright E2E&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="100" y="180" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="vercel" value="Vercel&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;build &amp; static hosting&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="520" y="180" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="spa" value="Browser &#8212; Sky Check&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;React 19 + TypeScript SPA, no backend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="290" y="330" width="340" height="90" as="geometry" />
        </mxCell>

        <mxCell id="weather" value="Open-Meteo API&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;weather + city geocoding, free &amp; keyless&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="postcode" value="postcodes.io API&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;UK postcode lookup, free &amp; keyless&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="490" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="on push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;exitX=0.35;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="repo" target="ci">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="on push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;exitX=0.65;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="repo" target="vercel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="serves the built app" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.65;entryY=0;fontSize=11;" edge="1" parent="1" source="vercel" target="spa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="test results (pass/fail)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;dashed=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.35;entryY=0;fontSize=10.5;" edge="1" parent="1" source="ci" target="spa">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="240" y="300" />
              <mxPoint x="360" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="fetch weather / search city" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;startArrow=block;endArrow=block;exitX=0.4;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="spa" target="weather">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="fetch postcode lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;startArrow=block;endArrow=block;exitX=0.6;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="spa" target="postcode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Solid = build/serve/data flow. Dashed = CI feedback only (doesn&#39;t touch the deployed app). Double-headed = client calls the API directly, straight from the browser." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontSize=11;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="750" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
