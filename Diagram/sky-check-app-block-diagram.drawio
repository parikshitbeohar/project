        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="search" target="page">
          <mxGeometry relative="1" as="geometry" />
