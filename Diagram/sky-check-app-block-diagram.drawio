<mxfile host="app.diagrams.net">
  <diagram name="App Block Diagram" id="skycheck-app-block">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sky Check &#8212; App Block Diagram" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="0" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="api1" value="Open-Meteo API&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;weather + city geocoding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="150" y="50" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api2" value="postcodes.io API&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;UK postcode lookup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="520" y="50" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="fetch" value="Data Fetching &amp; Caching&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;SWR &#8212; useWeather, useLocationSearch, useDebounce&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="280" y="170" width="460" height="70" as="geometry" />
        </mxCell>

        <mxCell id="search" value="Search &amp; Location&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;combobox, debounce, city/postcode auto-detect&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="display" value="Weather Display&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;current conditions + forecast&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="320" y="290" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="theme" value="Theming&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;background/colors by weather condition&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="580" y="290" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="loading" value="Loading &amp; Error Handling&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;overlays, retry, top-level ErrorBoundary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="810" y="290" width="250" height="90" as="geometry" />
        </mxCell>

        <mxCell id="page" value="Page Composition&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;WeatherPage.tsx &#8212; ties it all together, focus mgmt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="430" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Arrows show data/control flow within the app only &#8212; source control, CI, and deployment are deliberately left off this one." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontSize=11;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="150" y="540" width="750" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="api1" target="fetch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="api2" target="fetch">
          <mxGeometry relative="1" as="geometry" />
