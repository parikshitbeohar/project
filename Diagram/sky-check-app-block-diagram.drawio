            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fetch" target="loading">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="671" y="270" />
              <mxPoint x="935" y="270" />
